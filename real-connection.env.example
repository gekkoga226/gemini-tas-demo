# 実接続モード（start-app-real.bat）の設定テンプレート。
# このファイルを real-connection.env にコピーし、担当者が確認した値へ置き換える。
# real-connection.env はGit管理外。キー・トークン・パスワードは書かない（認証はgcloudログインを使う）。
# 各項目の意味は docs/FEWSHOT_OPERATIONS.md「設定」「実接続への移行」を参照。
# PORT / DATA_ROOT は起動元で明示した値が優先。使用中ポートのプロセスは停止しない。
PORT=4173
DATA_ROOT=data-real
GEAP_AUTH_MODE=gcloud
GEAP_PROJECT=CONFIRMED_PROJECT_ID
GEAP_LOCATION=global
GEAP_BUCKET=CONFIRMED_TEMP_BUCKET
GEAP_STAGE1_MODEL=CONFIRMED_GEMINI_MODEL_ID
GEAP_STAGE2_MODEL=CONFIRMED_GEMINI_MODEL_ID
MODEL_REVISION_SCOPE=YOUR_VALIDATION_SESSION_VERSION
GEAP_PRINCIPAL=CONFIRMED_CALLER_IDENTITY
MAX_UPLOAD_BYTES=2147483648
MIN_FREE_BYTES=1073741824
# gcloud auth login を実施し、project・権限・送信対象・同意を確認した後にだけ true にする。
GEAP_ENVIRONMENT_CONFIRMED=false
