{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work analysis result v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "data_source",
    "video",
    "standard_cards",
    "modes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "data_source": {
      "enum": [
        "demo",
        "imported",
        "gemini"
      ]
    },
    "video": {
      "type": "object",
      "required": [
        "name",
        "duration_sec",
        "size_bytes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 512
        },
        "duration_sec": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "standard_cards": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "duration_sec"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "maxLength": 2000
          },
          "duration_sec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "zero"
          ]
        },
        {
          "required": [
            "few"
          ]
        }
      ],
      "properties": {
        "zero": {
          "type": "object",
          "required": [
            "segments"
          ],
          "properties": {
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "start_sec",
                  "end_sec",
                  "action",
                  "activity",
                  "object",
                  "tool",
                  "location",
                  "before",
                  "after",
                  "evidence",
                  "standard_id",
                  "match_status",
                  "method_status",
                  "order_status",
                  "review_status",
                  "note"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "action": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "object": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "tool": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "before": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "start_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "standard_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "activity": {
                    "enum": [
                      "assembly",
                      "move",
                      "inspect",
                      "search",
                      "wait",
                      "prepare",
                      "unknown"
                    ]
                  },
                  "match_status": {
                    "enum": [
                      "matched",
                      "partial",
                      "unmatched",
                      "uncertain"
                    ]
                  },
                  "method_status": {
                    "enum": [
                      "conforming",
                      "deviating",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "order_status": {
                    "enum": [
                      "allowed",
                      "violation_candidate",
                      "unknown"
                    ]
                  },
                  "review_status": {
                    "enum": [
                      "draft",
                      "reviewed",
                      "verified"
                    ]
                  }
                }
              }
            }
          }
        },
        "few": {
          "type": "object",
          "required": [
            "segments"
          ],
          "properties": {
            "segments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5000,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "start_sec",
                  "end_sec",
                  "action",
                  "activity",
                  "object",
                  "tool",
                  "location",
                  "before",
                  "after",
                  "evidence",
                  "standard_id",
                  "match_status",
                  "method_status",
                  "order_status",
                  "review_status",
                  "note"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "action": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "object": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "tool": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "before": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "start_sec": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "standard_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "activity": {
                    "enum": [
                      "assembly",
                      "move",
                      "inspect",
                      "search",
                      "wait",
                      "prepare",
                      "unknown"
                    ]
                  },
                  "match_status": {
                    "enum": [
                      "matched",
                      "partial",
                      "unmatched",
                      "uncertain"
                    ]
                  },
                  "method_status": {
                    "enum": [
                      "conforming",
                      "deviating",
                      "unknown",
                      "not_applicable"
                    ]
                  },
                  "order_status": {
                    "enum": [
                      "allowed",
                      "violation_candidate",
                      "unknown"
                    ]
                  },
                  "review_status": {
                    "enum": [
                      "draft",
                      "reviewed",
                      "verified"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "array",
      "maxItems": 10000
    },
    "tt_sec": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    }
  }
}
